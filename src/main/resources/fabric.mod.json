{
  "schemaVersion": 1,
  "id": "totem-lumen",
  "version": "${version}",
  "name": "Totem Lumen",
  "description": "Vulkan-first real-time lighting and voxel ray tracing for Minecraft 26.2.",
  "authors": [
    "Yunitrish006006"
  ],
  "contact": {
    "sources": "https://github.com/Yunitrish006006/TotemLumen"
  },
  "license": "Apache-2.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.totem.lumen.TotemLumen"
    ],
    "client": [
      "dev.totem.lumen.TotemLumenClient"
    ]
  },
  "mixins": [
    {
      "config": "totem-lumen.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
